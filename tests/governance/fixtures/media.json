{
  "mediaRendering": {
    "renderingId": "render-waliin-production",
    "version": "1.0.0",
    "name": "Waliin Studio Production Rendering Pipeline",
    "scope": {
      "level": "global",
      "contentTypes": ["short_drama", "movie", "series_episode", "trailer", "teaser"]
    },
    "ingestPipeline": {
      "enabled": true,
      "sources": [
        {
          "sourceId": "source-direct-upload",
          "name": "Direct Upload",
          "type": "direct_upload",
          "location": "https://upload.sl18.io/ingest",
          "acceptedFormats": ["mp4", "mov", "prores", "mxf"],
          "maxFileSize": 50000,
          "validation": {
            "checksum": true,
            "virusScan": true,
            "metadataValidation": true
          },
          "enabled": true
        },
        {
          "sourceId": "source-capcut",
          "name": "CapCut Export",
          "type": "capcut_export",
          "location": "s3://sl18-capcut-exports/",
          "acceptedFormats": ["mp4", "mov"],
          "maxFileSize": 20000,
          "validation": {
            "checksum": true,
            "virusScan": true,
            "metadataValidation": true
          },
          "enabled": true
        },
        {
          "sourceId": "source-s3-raw",
          "name": "S3 Raw Assets",
          "type": "s3",
          "location": "s3://sl18-raw-assets/",
          "acceptedFormats": ["prores", "dnxhd", "raw", "mxf"],
          "maxFileSize": 100000,
          "validation": {
            "checksum": true,
            "virusScan": false,
            "metadataValidation": true
          },
          "enabled": true
        }
      ],
      "preprocessing": {
        "deinterlace": true,
        "denoising": false,
        "colorCorrection": true,
        "audioNormalization": true,
        "frameRateConversion": true
      },
      "qualityAnalysis": {
        "enabled": true,
        "metrics": ["vmaf", "psnr", "ssim", "bitrate_consistency", "audio_loudness", "black_frames", "scene_detection"],
        "minimumVmaf": 85
      }
    },
    "transcoding": {
      "enabled": true,
      "engine": "mediaconvert",
      "videoCodecs": [
        {
          "codecId": "codec-h264",
          "codec": "h264",
          "profile": "high",
          "bitDepth": 8,
          "hardwareAcceleration": "nvenc",
          "enabled": true
        },
        {
          "codecId": "codec-h265",
          "codec": "h265_hevc",
          "profile": "main10",
          "bitDepth": 10,
          "hardwareAcceleration": "nvenc",
          "enabled": true
        },
        {
          "codecId": "codec-av1",
          "codec": "av1",
          "profile": "main",
          "bitDepth": 10,
          "hardwareAcceleration": "none",
          "enabled": true
        }
      ],
      "audioCodecs": [
        {
          "codecId": "codec-aac",
          "codec": "aac",
          "channels": "stereo",
          "sampleRate": 48000,
          "enabled": true
        },
        {
          "codecId": "codec-ac3",
          "codec": "ac3",
          "channels": "5.1",
          "sampleRate": 48000,
          "enabled": true
        },
        {
          "codecId": "codec-opus",
          "codec": "opus",
          "channels": "stereo",
          "sampleRate": 48000,
          "enabled": true
        }
      ],
      "renditions": [
        {
          "renditionId": "rendition-4k",
          "name": "4K UHD",
          "resolution": {
            "width": 3840,
            "height": 2160,
            "aspectRatio": "16:9"
          },
          "videoBitrate": {
            "target": 15000,
            "max": 20000,
            "min": 10000,
            "mode": "vbr"
          },
          "audioBitrate": 256,
          "frameRate": 24,
          "deviceTarget": "smart_tv",
          "priority": 1,
          "enabled": true
        },
        {
          "renditionId": "rendition-1080p",
          "name": "Full HD",
          "resolution": {
            "width": 1920,
            "height": 1080,
            "aspectRatio": "16:9"
          },
          "videoBitrate": {
            "target": 6000,
            "max": 8000,
            "min": 4000,
            "mode": "vbr"
          },
          "audioBitrate": 192,
          "frameRate": 24,
          "deviceTarget": "desktop",
          "priority": 2,
          "enabled": true
        },
        {
          "renditionId": "rendition-720p",
          "name": "HD Ready",
          "resolution": {
            "width": 1280,
            "height": 720,
            "aspectRatio": "16:9"
          },
          "videoBitrate": {
            "target": 3000,
            "max": 4000,
            "min": 2000,
            "mode": "vbr"
          },
          "audioBitrate": 128,
          "frameRate": 24,
          "deviceTarget": "tablet",
          "priority": 3,
          "enabled": true
        },
        {
          "renditionId": "rendition-480p",
          "name": "SD",
          "resolution": {
            "width": 854,
            "height": 480,
            "aspectRatio": "16:9"
          },
          "videoBitrate": {
            "target": 1500,
            "max": 2000,
            "min": 1000,
            "mode": "vbr"
          },
          "audioBitrate": 96,
          "frameRate": 24,
          "deviceTarget": "mobile_small",
          "priority": 4,
          "enabled": true
        },
        {
          "renditionId": "rendition-vertical",
          "name": "Vertical (9:16)",
          "resolution": {
            "width": 1080,
            "height": 1920,
            "aspectRatio": "9:16"
          },
          "videoBitrate": {
            "target": 4000,
            "max": 5000,
            "min": 2500,
            "mode": "vbr"
          },
          "audioBitrate": 128,
          "frameRate": 30,
          "deviceTarget": "mobile_large",
          "priority": 5,
          "enabled": true
        }
      ],
      "optimizations": {
        "perTitleEncoding": true,
        "contentAdaptive": true,
        "twoPassEncoding": true,
        "sceneDetection": true,
        "hdrToSdr": true
      }
    },
    "packaging": {
      "enabled": true,
      "formats": [
        {
          "formatId": "format-hls",
          "format": "hls",
          "segmentDuration": 6,
          "encryption": {
            "enabled": true,
            "drm": ["fairplay"],
            "keyRotation": false
          },
          "manifestConfig": {
            "includeLoudness": true,
            "includeThumbnails": true,
            "subtitleFormat": "webvtt"
          },
          "enabled": true
        },
        {
          "formatId": "format-dash",
          "format": "dash",
          "segmentDuration": 6,
          "encryption": {
            "enabled": true,
            "drm": ["widevine", "playready"],
            "keyRotation": false
          },
          "manifestConfig": {
            "includeLoudness": true,
            "includeThumbnails": true,
            "subtitleFormat": "ttml"
          },
          "enabled": true
        },
        {
          "formatId": "format-cmaf",
          "format": "cmaf",
          "segmentDuration": 6,
          "encryption": {
            "enabled": true,
            "drm": ["widevine", "fairplay", "playready"],
            "keyRotation": false
          },
          "manifestConfig": {
            "includeLoudness": true,
            "includeThumbnails": true,
            "subtitleFormat": "webvtt"
          },
          "enabled": true
        }
      ],
      "lowLatency": {
        "enabled": false,
        "targetLatency": 3,
        "partDuration": 0.5
      }
    },
    "thumbnails": {
      "enabled": true,
      "generation": {
        "interval": 10,
        "sizes": [
          {"width": 320, "height": 180, "format": "jpg"},
          {"width": 640, "height": 360, "format": "jpg"},
          {"width": 1280, "height": 720, "format": "webp"}
        ],
        "spriteSheets": true,
        "aiSelection": true
      },
      "poster": {
        "enabled": true,
        "aiGenerated": true,
        "sizes": [
          {"name": "small", "width": 300, "height": 450},
          {"name": "medium", "width": 600, "height": 900},
          {"name": "large", "width": 1200, "height": 1800}
        ]
      }
    },
    "trailers": {
      "enabled": true,
      "autoGeneration": {
        "enabled": true,
        "algorithm": "ai_summary",
        "durations": [15, 30, 60, 120]
      },
      "teasers": {
        "enabled": true,
        "shortFormPlatforms": ["tiktok", "instagram_reels", "youtube_shorts"],
        "durations": [15, 30, 60]
      }
    },
    "storage": {
      "primaryStorage": {
        "provider": "s3",
        "bucket": "sl18-media-production",
        "region": "us-east-1",
        "storageClass": "standard"
      },
      "replication": {
        "enabled": true,
        "destinations": [
          {"region": "eu-west-1", "bucket": "sl18-media-eu"},
          {"region": "ap-southeast-1", "bucket": "sl18-media-apac"}
        ]
      },
      "lifecycle": {
        "hotStorageDays": 30,
        "warmStorageDays": 90,
        "archiveAfterDays": 365,
        "deleteAfterDays": 2555
      }
    },
    "scheduling": {
      "priority": "high",
      "queues": {
        "realtime": {
          "maxConcurrent": 10,
          "timeout": 60
        },
        "standard": {
          "maxConcurrent": 50,
          "timeout": 240
        },
        "batch": {
          "maxConcurrent": 100,
          "scheduleWindow": "0 2 * * *"
        }
      }
    },
    "metrics": {
      "jobsCompleted": 15234,
