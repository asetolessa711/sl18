    "alerting": {
      "enabled": true,
      "rules": [
        {
          "ruleId": "alert-high-error",
          "name": "High Error Rate",
          "metric": "error_rate",
          "condition": {
            "operator": "gt",
            "threshold": 1,
            "duration": 300
          },
          "severity": "critical",
          "channels": ["pagerduty", "slack"],
          "runbook": "https://docs.sl18.io/runbooks/high-error-rate",
          "enabled": true
        },
        {
          "ruleId": "alert-slow-startup",
          "name": "Slow Startup Time",
          "metric": "avg_startup_time",
          "condition": {
            "operator": "gt",
            "threshold": 5,
            "duration": 180
          },
          "severity": "high",
          "channels": ["slack", "email"],
          "runbook": "https://docs.sl18.io/runbooks/slow-startup",
          "enabled": true
        },
        {
          "ruleId": "alert-rebuffer",
          "name": "High Rebuffer Ratio",
          "metric": "rebuffer_ratio",
          "condition": {
            "operator": "gt",
            "threshold": 2,
            "duration": 300
          },
          "severity": "high",
          "channels": ["slack"],
          "runbook": "https://docs.sl18.io/runbooks/high-rebuffer",
          "enabled": true
        },
        {
          "ruleId": "alert-cdn-miss",
          "name": "Low CDN Cache Hit Rate",
          "metric": "cdn_cache_hit_ratio",
          "condition": {
            "operator": "lt",
            "threshold": 90,
            "duration": 600
          },
          "severity": "medium",
          "channels": ["slack"],
          "runbook": "https://docs.sl18.io/runbooks/cdn-cache-miss",
          "enabled": true
        }
      ],
      "suppressionRules": [
        {
          "ruleId": "suppress-maintenance",
          "alertRules": ["alert-high-error", "alert-slow-startup"],
          "schedule": "0 2 * * 0",
          "reason": "Weekly maintenance window"
        }
      ]
    },
    "reporting": {
