  "mediaObservability": {
    "observabilityId": "mobs-waliin-production",
    "version": "1.0.0",
    "name": "Waliin Studio Media Observability",
    "scope": {
      "level": "global",
      "platforms": ["web", "ios", "android", "smart_tv", "ott"],
      "regions": ["us-east-1", "eu-west-1", "ap-southeast-1", "af-south-1"]
    },
    "playbackMetrics": {
      "enabled": true,
      "collection": {
        "provider": "mux",
        "samplingRate": 100,
        "beaconInterval": 10
      },
      "qoe": {
        "startupTime": {
          "target": 2,
          "warning": 3,
          "critical": 5
        },
        "rebufferRatio": {
          "target": 0.5,
          "warning": 1,
          "critical": 2
        },
        "playbackFailure": {
          "target": 0.1,
          "warning": 0.5,
          "critical": 1
        },
        "videoPrimaryResolution": {
          "target": 90,
          "warning": 80
        }
      },
      "events": [
        {
          "eventId": "event-play-request",
          "event": "play_request",
          "track": true,
          "properties": ["content_id", "user_id", "device_type", "region"]
        },
        {
          "eventId": "event-play-start",
          "event": "play_start",
          "track": true,
          "properties": ["startup_time", "initial_bitrate", "resolution"]
        },
        {
          "eventId": "event-buffer",
          "event": "buffer_start",
          "track": true,
          "properties": ["buffer_time", "current_bitrate", "playhead_position"]
        },
        {
          "eventId": "event-quality",
          "event": "quality_change",
          "track": true,
          "properties": ["from_bitrate", "to_bitrate", "reason"]
        },
        {
          "eventId": "event-error",
          "event": "error",
          "track": true,
          "properties": ["error_code", "error_message", "stack_trace", "device_info"]
        },
        {
          "eventId": "event-complete",
          "event": "complete",
          "track": true,
          "properties": ["watch_time", "completion_percentage"]
        }
      ]
    },
    "errorTracking": {
      "enabled": true,
      "categories": [
        {
          "categoryId": "error-network",
          "name": "Network Errors",
          "category": "network",
          "errorCodes": ["NET_001", "NET_002", "NET_003", "TIMEOUT"],
          "severity": "high",
          "alerting": {
            "enabled": true,
            "threshold": 1,
            "channels": ["slack", "pagerduty"]
          }
        },
        {
          "categoryId": "error-drm",
          "name": "DRM Errors",
          "category": "drm",
          "errorCodes": ["DRM_001", "LICENSE_FAIL", "KEY_ROTATION"],
          "severity": "critical",
          "alerting": {
            "enabled": true,
            "threshold": 0.5,
            "channels": ["pagerduty", "email"]
          }
        },
        {
          "categoryId": "error-decoder",
          "name": "Decoder Errors",
          "category": "decoder",
          "errorCodes": ["CODEC_UNSUPPORTED", "DECODE_FAIL"],
          "severity": "medium",
          "alerting": {
            "enabled": true,
            "threshold": 2,
            "channels": ["slack"]
          }
        },
        {
          "categoryId": "error-cdn",
          "name": "CDN Errors",
          "category": "cdn",
          "errorCodes": ["CDN_500", "CDN_502", "CDN_503", "CDN_504"],
          "severity": "critical",
          "alerting": {
            "enabled": true,
            "threshold": 0.5,
            "channels": ["pagerduty", "slack"]
          }
        }
      ],
      "stackTraceCollection": true,
      "deviceInfo": true,
      "networkInfo": true
    },
    "regionHeatmaps": {
      "enabled": true,
      "granularity": "city",
