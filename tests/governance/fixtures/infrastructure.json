{
  "infrastructureResilience": {
    "resilienceId": "infra-sl18-production-global",
    "version": "1.0.0",
    "name": "SL18 Production Global Resilience",
    "scope": {
      "level": "global",
      "services": ["api-gateway", "content-service", "persona-service", "distribution-service", "analytics-service"],
      "regions": ["us-east-1", "eu-west-1", "ap-southeast-1"],
      "environments": ["production"]
    },
    "multiRegion": {
      "enabled": true,
      "topology": "active_active",
      "primaryRegion": "us-east-1",
      "regions": [
        {
          "regionId": "us-east-1",
          "name": "US East (Virginia)",
          "provider": "aws",
          "zones": ["us-east-1a", "us-east-1b", "us-east-1c"],
          "role": "primary",
          "priority": 1,
          "status": "active",
          "capacity": {
            "maxInstances": 100,
            "currentInstances": 45,
            "targetUtilization": 70
          },
          "latency": {
            "toPrimary": 0,
            "threshold": 100
          }
        },
        {
          "regionId": "eu-west-1",
          "name": "EU West (Ireland)",
          "provider": "aws",
          "zones": ["eu-west-1a", "eu-west-1b", "eu-west-1c"],
          "role": "secondary",
          "priority": 2,
          "status": "active",
          "capacity": {
            "maxInstances": 80,
            "currentInstances": 35,
            "targetUtilization": 70
          },
          "latency": {
            "toPrimary": 85,
            "threshold": 150
          }
        },
        {
          "regionId": "ap-southeast-1",
          "name": "Asia Pacific (Singapore)",
          "provider": "aws",
          "zones": ["ap-southeast-1a", "ap-southeast-1b", "ap-southeast-1c"],
          "role": "secondary",
          "priority": 3,
          "status": "active",
          "capacity": {
            "maxInstances": 60,
            "currentInstances": 25,
            "targetUtilization": 70
          },
          "latency": {
            "toPrimary": 220,
            "threshold": 300
          }
        }
      ],
      "dataReplication": {
        "mode": "asynchronous",
        "lagThreshold": 5,
        "conflictResolution": "last_write_wins"
      },
      "dnsRouting": {
        "strategy": "latency_based",
        "healthCheck": {
          "enabled": true,
          "protocol": "https",
          "path": "/health",
          "interval": 10,
          "threshold": 3
        }
      }
    },
    "failover": {
      "enabled": true,
      "mode": "automatic",
      "triggers": [
        {
          "triggerId": "trigger-health-failure",
          "name": "Health Check Failure",
          "condition": "health_check_failure",
          "consecutiveFailures": 3,
          "enabled": true
        },
        {
          "triggerId": "trigger-error-rate",
          "name": "Error Rate Threshold",
          "condition": "error_rate_threshold",
          "threshold": 5,
          "duration": 60,
          "enabled": true
        },
        {
          "triggerId": "trigger-latency",
          "name": "Latency Threshold",
          "condition": "latency_threshold",
          "threshold": 2000,
          "duration": 120,
          "enabled": true
        }
      ],
      "failoverTime": {
        "target": 60,
        "maximum": 300
      },
      "failback": {
        "enabled": true,
        "mode": "manual",
        "delay": 1800,
        "healthCheckDuration": 300
      },
      "circuitBreaker": {
        "enabled": true,
        "errorThreshold": 50,
        "openDuration": 30,
        "halfOpenRequests": 5
      }
    },
    "loadBalancing": {
      "enabled": true,
      "type": "global",
      "algorithm": "least_response_time",
      "healthCheck": {
        "protocol": "https",
        "path": "/health",
        "port": 443,
        "interval": 10,
        "timeout": 5,
        "healthyThreshold": 2,
        "unhealthyThreshold": 3
      },
      "stickySession": {
        "enabled": false,
        "type": "cookie",
        "duration": 3600
      },
      "connectionDraining": {
        "enabled": true,
        "timeout": 300
      }
    },
    "scaling": {
      "enabled": true,
      "horizontal": {
        "enabled": true,
        "minInstances": 3,
        "maxInstances": 100,
        "targetUtilization": 70,
        "scaleUpCooldown": 60,
        "scaleDownCooldown": 300,
        "metrics": [
          {
            "name": "cpu",
            "targetValue": 70,
            "scaleUpThreshold": 80,
            "scaleDownThreshold": 40
          },
          {
            "name": "requests_per_second",
            "targetValue": 1000,
            "scaleUpThreshold": 1200,
            "scaleDownThreshold": 500
          }
        ]
      },
      "vertical": {
        "enabled": true,
        "minCpu": "500m",
        "maxCpu": "4000m",
        "minMemory": "512Mi",
        "maxMemory": "8Gi",
        "updateMode": "auto"
      },
      "predictive": {
        "enabled": true,
        "algorithm": "ml_forecast",
        "lookAhead": 30,
        "scheduledEvents": [
          {
            "eventId": "event-premiere-scaling",
            "name": "Premiere Night Scaling",
            "schedule": "0 18 * * 5",
            "targetInstances": 80,
            "duration": 240
          }
        ]
      },
      "burstCapacity": {
        "enabled": true,
        "maxBurstInstances": 50,
        "burstThreshold": 90,
        "burstDuration": 300
      }
    },
    "edgeNodes": {
      "enabled": true,
      "provider": "cloudflare",
      "nodes": [
        {
          "nodeId": "edge-us-west",
          "location": "Los Angeles, US",
          "status": "active",
          "cacheHitRate": 94.5
        },
        {
          "nodeId": "edge-eu-central",
          "location": "Frankfurt, DE",
          "status": "active",
          "cacheHitRate": 92.3
        },
        {
          "nodeId": "edge-ap-south",
          "location": "Mumbai, IN",
          "status": "active",
          "cacheHitRate": 89.7
        }
      ],
      "cacheTtl": {
        "static": 86400,
        "dynamic": 300,
        "api": 60
      }
    },
    "serviceDiscovery": {
      "enabled": true,
      "provider": "kubernetes",
      "healthCheck": {
        "interval": 10,
        "timeout": 5,
        "deregisterCriticalAfter": 60
      }
    },
    "sla": {
      "targetUptime": 99.95,
      "maxDowntime": {
        "monthly": 22,
        "yearly": 262
      },
      "latencyTargets": {
        "p50": 100,
        "p95": 300,
        "p99": 500
      },
      "errorBudget": {
        "monthly": 0.05,
        "consumed": 0.012
      }
    },
    "metrics": {
      "currentUptime": 99.98,
      "activeRegions": 3,
      "totalInstances": 105,
      "healthyInstances": 105,
      "failoversThisMonth": 0,
      "avgLatency": 85,
      "lastIncident": "2024-10-15T08:30:00Z",
      "lastUpdated": "2024-11-28T04:00:00Z"
    },
    "status": "active",
    "createdAt": "2024-01-15T00:00:00Z",
    "updatedAt": "2024-11-28T04:00:00Z",
    "createdBy": "platform-team"
  },
  "disasterRecovery": {
    "planId": "dr-sl18-production",
    "version": "2.1.0",
    "name": "SL18 Production Disaster Recovery Plan",
    "scope": {
      "level": "global",
      "services": ["api-gateway", "content-service", "persona-service", "distribution-service", "analytics-service", "database-cluster"],
      "dataTiers": ["critical", "high", "medium"],
      "environments": ["production"]
    },
    "objectives": {
      "rto": {
        "target": 15,
        "maximum": 30,
        "tier": "critical"
      },
      "rpo": {
        "target": 5,
        "maximum": 15,
        "tier": "near_zero"
      },
      "mtpd": 4,
      "mbco": 80
    },
    "backupPolicy": {
      "enabled": true,
      "schedules": [
        {
          "scheduleId": "backup-continuous",
          "name": "Continuous Replication",
          "type": "continuous",
          "frequency": "continuous",
          "retention": {
            "count": 1,
            "days": 1
          },
          "enabled": true
        },
        {
          "scheduleId": "backup-hourly",
          "name": "Hourly Snapshots",
          "type": "snapshot",
          "frequency": "hourly",
          "cronExpression": "0 * * * *",
          "retention": {
            "count": 24,
            "days": 1
          },
          "enabled": true
        },
        {
          "scheduleId": "backup-daily",
          "name": "Daily Full Backup",
          "type": "full",
          "frequency": "daily",
          "cronExpression": "0 2 * * *",
          "retention": {
            "count": 30,
            "days": 30
          },
          "enabled": true
        },
        {
          "scheduleId": "backup-weekly",
          "name": "Weekly Archive",
          "type": "full",
          "frequency": "weekly",
          "cronExpression": "0 3 * * 0",
          "retention": {
            "count": 12,
            "days": 90
          },
          "enabled": true
        }
      ],
      "targets": [
        {
          "targetId": "target-primary-db",
          "type": "database",
          "location": "s3://sl18-backups-us-east-1/databases/",
          "encryption": {
            "enabled": true,
            "algorithm": "AES-256-GCM",
            "keyManagement": "aws_kms"
          },
          "replication": {
            "enabled": true,
            "destinations": ["s3://sl18-backups-eu-west-1/databases/", "s3://sl18-backups-ap-southeast-1/databases/"]
          }
        },
        {
          "targetId": "target-content",
          "type": "object_storage",
          "location": "s3://sl18-backups-us-east-1/content/",
          "encryption": {
            "enabled": true,
            "algorithm": "AES-256-GCM",
            "keyManagement": "aws_kms"
          },
          "replication": {
            "enabled": true,
            "destinations": ["s3://sl18-backups-eu-west-1/content/"]
          }
        },
        {
          "targetId": "target-config",
          "type": "configuration",
          "location": "s3://sl18-backups-us-east-1/config/",
          "encryption": {
            "enabled": true,
            "algorithm": "AES-256-GCM",
            "keyManagement": "hashicorp_vault"
          },
          "replication": {
            "enabled": true,
            "destinations": ["s3://sl18-backups-eu-west-1/config/", "s3://sl18-backups-ap-southeast-1/config/"]
          }
        }
      ],
      "validation": {
        "enabled": true,
        "frequency": "daily",
        "methods": ["checksum", "restore_test", "integrity_check"]
      },
      "immutability": {
        "enabled": true,
        "retentionPeriod": 30,
        "legalHold": false
      }
    },
    "recoveryProcedures": [
      {
        "procedureId": "proc-region-outage",
        "name": "Region Outage Recovery",
        "scenario": "region_outage",
        "priority": 1,
        "steps": [
          {
            "stepNumber": 1,
            "name": "Detect Outage",
            "description": "Automated detection via health checks and monitoring alerts",
            "responsible": "automation",
            "estimatedTime": 1,
            "automated": true,
            "runbook": "https://docs.sl18.io/runbooks/region-outage-detection",
            "validationCriteria": "Alert triggered and acknowledged"
          },
          {
            "stepNumber": 2,
            "name": "Initiate Failover",
            "description": "Automatic DNS failover to secondary region",
            "responsible": "automation",
            "estimatedTime": 2,
            "automated": true,
            "runbook": "https://docs.sl18.io/runbooks/dns-failover",
            "validationCriteria": "DNS records updated, traffic routing to secondary"
          },
          {
            "stepNumber": 3,
            "name": "Verify Services",
            "description": "Validate all services are healthy in secondary region",
            "responsible": "on_call_engineer",
            "estimatedTime": 5,
            "automated": false,
            "runbook": "https://docs.sl18.io/runbooks/service-verification",
            "validationCriteria": "All health checks passing"
          },
          {
            "stepNumber": 4,
            "name": "Notify Stakeholders",
            "description": "Send status update to internal teams and update status page",
            "responsible": "on_call_engineer",
            "estimatedTime": 2,
            "automated": true,
            "runbook": "https://docs.sl18.io/runbooks/incident-communication",
            "validationCriteria": "Notifications sent, status page updated"
          }
        ],
        "estimatedRecoveryTime": 10,
        "dependencies": ["dns-service", "load-balancer"],
        "rollbackProcedure": "proc-region-failback"
      },
      {
        "procedureId": "proc-database-corruption",
        "name": "Database Corruption Recovery",
        "scenario": "database_corruption",
        "priority": 1,
        "steps": [
          {
            "stepNumber": 1,
            "name": "Isolate Affected Database",
            "description": "Stop writes to corrupted database, switch to replica",
            "responsible": "automation",
            "estimatedTime": 2,
            "automated": true,
            "runbook": "https://docs.sl18.io/runbooks/db-isolation",
            "validationCriteria": "Traffic routed to healthy replica"
          },
          {
            "stepNumber": 2,
            "name": "Assess Corruption Extent",
            "description": "Run integrity checks to determine scope of corruption",
            "responsible": "platform_team",
            "estimatedTime": 10,
            "automated": false,
            "runbook": "https://docs.sl18.io/runbooks/db-integrity-check",
            "validationCriteria": "Corruption scope identified"
          },
          {
            "stepNumber": 3,
            "name": "Point-in-Time Recovery",
            "description": "Restore from last known good backup with transaction log replay",
            "responsible": "platform_team",
            "estimatedTime": 15,
            "automated": false,
            "runbook": "https://docs.sl18.io/runbooks/pitr-restore",
            "validationCriteria": "Database restored to consistent state"
          },
          {
            "stepNumber": 4,
            "name": "Validate Data Integrity",
            "description": "Run validation queries and consistency checks",
            "responsible": "platform_team",
            "estimatedTime": 10,
            "automated": true,
            "runbook": "https://docs.sl18.io/runbooks/data-validation",
            "validationCriteria": "All validation checks pass"
          }
        ],
        "estimatedRecoveryTime": 37,
        "dependencies": ["backup-service", "replica-database"],
        "rollbackProcedure": "proc-db-rollback"
      }
    ],
    "playbooks": [
      {
        "playbookId": "playbook-auto-failover",
        "name": "Automated Regional Failover",
        "scenario": "region_outage",
        "triggerConditions": [
          {
            "conditionId": "cond-health-failure",
            "metric": "region_health_score",
            "operator": "lt",
            "threshold": 50,
            "duration": 60
          },
          {
            "conditionId": "cond-error-rate",
            "metric": "error_rate_5xx",
            "operator": "gt",
            "threshold": 20,
            "duration": 120
          }
        ],
        "automationLevel": "fully_automated",
        "escalation": {
          "enabled": true,
          "levels": [
            {
              "level": 1,
              "delay": 0,
              "contacts": ["on-call-engineer"],
              "channels": ["pagerduty", "slack"]
            },
            {
              "level": 2,
              "delay": 15,
              "contacts": ["platform-lead", "sre-manager"],
              "channels": ["pagerduty", "slack", "phone"]
            },
            {
              "level": 3,
              "delay": 30,
              "contacts": ["vp-engineering", "cto"],
              "channels": ["phone", "sms"]
            }
          ]
        },
        "communicationPlan": {
          "internalChannels": ["#incident-response", "#platform-alerts"],
          "externalChannels": ["status.sl18.io"],
          "statusPageUpdate": true,
          "customerNotification": true
        },
        "enabled": true
      }
    ],
    "chaosTesting": {
      "enabled": true,
      "provider": "gremlin",
      "experiments": [
        {
          "experimentId": "chaos-instance-termination",
