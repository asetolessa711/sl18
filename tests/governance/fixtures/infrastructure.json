        }
      ],
      "schedule": {
        "gameDay": {
          "enabled": true,
          "frequency": "quarterly",
          "lastGameDay": "2024-09-15T00:00:00Z",
          "nextGameDay": "2024-12-15T00:00:00Z"
        }
      }
    },
    "dataProtection": {
      "classification": [
        {
          "tier": "critical",
