  "infrastructureMonitoring": {
    "monitoringId": "mon-sl18-production",
    "version": "1.0.0",
    "name": "SL18 Production Infrastructure Monitoring",
    "scope": {
      "level": "global",
      "services": ["api-gateway", "content-service", "persona-service", "distribution-service", "analytics-service"],
      "regions": ["us-east-1", "eu-west-1", "ap-southeast-1"],
      "environments": ["production"]
    },
    "metricsCollection": {
      "enabled": true,
      "providers": [
        {
          "providerId": "prometheus-primary",
          "type": "prometheus",
          "endpoint": "https://prometheus.sl18.io",
          "scrapeInterval": 15,
          "retentionDays": 30,
          "enabled": true
        },
        {
          "providerId": "datadog-apm",
          "type": "datadog",
          "endpoint": "https://api.datadoghq.com",
          "scrapeInterval": 10,
          "retentionDays": 90,
          "enabled": true
        }
      ],
      "metrics": [
        {
          "metricId": "metric-uptime",
          "name": "Service Uptime",
          "type": "gauge",
          "category": "infrastructure",
          "unit": "percent",
          "aggregation": "avg",
          "labels": ["service", "region"],
          "enabled": true
        },
        {
          "metricId": "metric-latency-p99",
          "name": "Request Latency P99",
          "type": "histogram",
          "category": "application",
          "unit": "milliseconds",
          "aggregation": "p99",
          "labels": ["service", "endpoint", "region"],
          "enabled": true
        },
        {
          "metricId": "metric-error-rate",
          "name": "Error Rate",
          "type": "counter",
          "category": "application",
          "unit": "percent",
          "aggregation": "rate",
          "labels": ["service", "error_code", "region"],
          "enabled": true
        },
        {
          "metricId": "metric-requests",
          "name": "Requests Per Second",
          "type": "counter",
          "category": "application",
          "unit": "requests",
          "aggregation": "rate",
          "labels": ["service", "endpoint", "method"],
          "enabled": true
        }
      ],
      "customMetrics": {
        "enabled": true,
        "maxMetrics": 500,
        "namingPattern": "sl18.custom.*"
      }
    },
    "alerting": {
      "enabled": true,
      "rules": [
        {
          "ruleId": "alert-high-error-rate",
          "name": "High Error Rate",
          "description": "Error rate exceeds 1% for 5 minutes",
          "metric": "error_rate_5xx",
          "condition": {
            "operator": "gt",
            "threshold": 1,
            "duration": 300,
            "aggregation": "avg"
          },
          "severity": "critical",
          "notifications": {
            "channels": ["pagerduty", "slack"],
            "recipients": ["on-call-engineer", "#platform-alerts"],
            "suppressDuplicates": 300,
            "groupBy": ["service", "region"]
          },
          "runbook": "https://docs.sl18.io/runbooks/high-error-rate",
          "autoRemediation": {
            "enabled": true,
            "action": "restart_service",
            "maxAttempts": 2,
            "cooldown": 300
          },
          "enabled": true,
          "tags": ["critical", "sla-impacting"]
        },
        {
          "ruleId": "alert-high-latency",
          "name": "High Latency",
          "description": "P99 latency exceeds 500ms for 3 minutes",
          "metric": "request_latency_p99",
          "condition": {
            "operator": "gt",
            "threshold": 500,
            "duration": 180,
            "aggregation": "avg"
          },
          "severity": "high",
          "notifications": {
            "channels": ["slack", "email"],
            "recipients": ["#platform-alerts", "platform-team@sl18.io"],
            "suppressDuplicates": 600,
            "groupBy": ["service"]
          },
          "runbook": "https://docs.sl18.io/runbooks/high-latency",
          "autoRemediation": {
            "enabled": true,
            "action": "scale_up",
            "maxAttempts": 1,
            "cooldown": 600
          },
          "enabled": true,
          "tags": ["performance"]
        },
        {
          "ruleId": "alert-low-uptime",
          "name": "Low Service Uptime",
          "description": "Service uptime below 99.9%",
          "metric": "service_uptime",
          "condition": {
            "operator": "lt",
            "threshold": 99.9,
            "duration": 60,
            "aggregation": "avg"
          },
          "severity": "critical",
          "notifications": {
