          "assertions": [
            {
              "type": "status_code",
              "operator": "eq",
              "value": 200
            },
            {
              "type": "response_time",
              "operator": "lt",
              "value": 200
            },
            {
              "type": "header_contains",
              "operator": "contains",
              "value": "hit"
