        }
      ],
      "encryption": {
        "atRest": true,
        "inTransit": true,
        "backups": true
      }
    },
    "compliance": {
      "frameworks": ["ISO22301", "SOC2"],
      "auditSchedule": "annually",
      "lastAudit": "2024-03-15T00:00:00Z",
