      "recoverySuccessRate": 100,
      "chaosTestsCompleted": 24,
      "chaosTestsSuccessful": 23,
      "drillsCompleted": 4,
      "lastBackupTime": "2024-11-28T03:00:00Z",
      "lastRecoveryTest": "2024-11-20T00:00:00Z",
      "lastUpdated": "2024-11-28T04:00:00Z"
    },
    "status": "active",
    "createdAt": "2024-01-01T00:00:00Z",
