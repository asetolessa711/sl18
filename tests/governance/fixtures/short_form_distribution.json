      "metadataMapping": {
        "mappingVersion": "1.0",
        "titleField": "title",
        "descriptionField": "synopsis",
        "genreMapping": {
          "drama": "DRAMA",
          "romance": "ROMANCE",
          "comedy": "COMEDY",
          "thriller": "THRILLER"
        },
        "ratingMapping": {
          "G": "ALL",
          "PG": "7+",
          "PG-13": "13+",
          "TV-14": "14+"
        },
        "customFields": [
          {
            "sourceField": "personas",
            "targetField": "cast_tags",
            "transform": "array_to_csv"
          }
        ]
      },
      "formatRequirements": {
        "videoFormats": [
          {
            "codec": "h264",
            "container": "mp4",
            "resolution": "1080p",
            "bitrate": 8000000,
            "framerate": 30
          },
          {
            "codec": "h265",
            "container": "mp4",
            "resolution": "4k",
            "bitrate": 15000000,
            "framerate": 30
