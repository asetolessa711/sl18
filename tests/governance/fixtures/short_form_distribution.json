        "autoRenewal": true,
        "renewalTerms": "12-month auto-renewal with 60-day notice"
      }
    },
    "apiConfiguration": {
      "baseUrl": "https://api.dramabox.com/v2",
      "apiVersion": "2.0",
      "authType": "oauth2",
      "credentialRef": "vault://sl18/partners/dramabox/oauth",
      "scopes": ["content:write", "content:read", "analytics:read", "metadata:write"],
      "rateLimits": {
        "requestsPerMinute": 100,
        "requestsPerDay": 10000,
        "burstLimit": 20
      },
      "timeout": {
        "connectTimeoutMs": 10000,
        "readTimeoutMs": 30000
      },
      "retryPolicy": {
        "maxRetries": 3,
        "backoffMultiplier": 2,
        "initialDelayMs": 1000,
        "maxDelayMs": 30000,
        "retryableStatusCodes": [429, 500, 502, 503, 504]
      },
      "endpoints": [
        {
          "endpointId": "ep-content-upload",
          "name": "Content Upload",
          "method": "POST",
          "path": "/content/upload",
          "description": "Upload new content to Drama Box",
          "purpose": "content_upload",
          "required": true
        },
        {
          "endpointId": "ep-content-update",
          "name": "Content Update",
          "method": "PUT",
          "path": "/content/{contentId}",
          "description": "Update existing content metadata",
          "purpose": "content_update",
          "required": true
        },
        {
          "endpointId": "ep-analytics",
          "name": "Analytics Fetch",
          "method": "GET",
          "path": "/analytics/content/{contentId}",
          "description": "Fetch content analytics",
          "purpose": "analytics_fetch",
          "required": true
        },
        {
          "endpointId": "ep-status",
          "name": "Status Check",
          "method": "GET",
          "path": "/content/{contentId}/status",
          "description": "Check content syndication status",
          "purpose": "status_check",
          "required": true
        }
      ],
      "webhooks": {
        "enabled": true,
        "callbackUrl": "https://api.sl18.io/webhooks/dramabox",
        "secretRef": "vault://sl18/partners/dramabox/webhook-secret",
        "events": ["content_published", "playback_started", "playback_completed", "monetization_event"],
        "retryPolicy": {
          "maxRetries": 5,
          "backoffMs": 2000
        }
      }
    },
    "syndicationRules": {
      "autoSyndicate": false,
      "approvalRequired": true,
      "contentFilters": {
        "contentTypes": ["short_drama", "episode", "movie"],
        "genres": ["drama", "romance", "comedy", "thriller", "historical"],
        "excludedGenres": ["horror", "adult"],
        "contentRatings": ["G", "PG", "PG-13", "TV-14"],
        "languages": ["en", "am", "sw", "om", "ar", "zh"],
        "minimumQcScore": 85,
        "requiredQcPasses": ["technical", "content", "cultural", "translation"]
