        "aspectRatios": ["9:16", "16:9"],
        "audioFormats": [
          {
            "codec": "aac",
            "channels": "stereo",
            "sampleRate": 48000
          }
        ],
        "subtitleFormats": ["srt", "vtt"],
        "thumbnailRequirements": {
          "formats": ["jpg", "webp"],
          "minWidth": 1280,
          "minHeight": 720,
          "aspectRatio": "16:9"
        },
        "maxDurationSeconds": 600,
        "minDurationSeconds": 60
      },
      "packagingOptions": {
        "generateTeasers": true,
        "teaserDurationSeconds": 30,
        "generateVerticalClips": true,
        "burnInSubtitles": false,
        "addWatermark": true,
        "watermarkPosition": "bottom_right"
      },
      "schedulingRules": {
        "immediatePublish": false,
        "delayAfterPrimaryMinutes": 1440,
        "exclusivityWindowDays": 7,
        "releaseWindow": {
          "startHour": 18,
          "endHour": 22,
          "timezone": "UTC",
          "preferredDays": ["friday", "saturday", "sunday"]
        }
      }
