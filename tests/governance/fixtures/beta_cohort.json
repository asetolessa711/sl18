    },
    "feedbackCollection": {
      "channels": [
        { "channelId": "fb-1", "name": "Daily Syncs", "type": "interview", "cohortPhases": ["internal_beta"], "frequency": "daily", "automated": false },
        { "channelId": "fb-2", "name": "Surveys", "type": "survey", "cohortPhases": ["closed_beta", "open_beta"], "frequency": "phase_end", "automated": true }
      ],
      "analysisConfig": {
        "sentimentAnalysis": true,
        "categoryTagging": true,
        "priorityScoring": true,
        "trendDetection": true,
        "anomalyAlerts": true
      },
      "escalationRules": [
        { "ruleId": "esc-1", "trigger": "Critical bug", "severity": "critical", "escalateTo": ["engineering_lead", "ceo"], "slaMinutes": 30, "notificationChannels": ["slack", "pagerduty"] }
      ]
    },
    "issueTracking": {
      "categories": ["critical_bug", "high_bug", "medium_bug", "security_issue"],
      "slaByCategory": {
        "critical_bug": { "responseMinutes": 15, "resolutionHours": 4 },
        "security_issue": { "responseMinutes": 15, "resolutionHours": 2 }
      },
      "triageWorkflow": {
        "autoCategorizationEnabled": true,
        "dailyTriageMeeting": true,
        "triageMeetingTime": "09:00",
        "triageOwner": "qa_lead"
      }
    },
    "ceoDashboard": {
      "enabled": true,
      "widgets": [
        { "widgetId": "ceo-1", "name": "Beta Progress", "type": "progress_tracker", "dataSource": "cohort_phases", "refreshInterval": "hourly" },
        { "widgetId": "ceo-2", "name": "Revenue", "type": "trend_chart", "dataSource": "monetization", "refreshInterval": "hourly" }
      ],
      "dailyBriefing": {
        "enabled": true,
        "deliveryTime": "07:00",
        "deliveryChannels": ["email", "slack"],
        "includeMetrics": ["dau", "signups", "conversions", "revenue"]
      },
      "escalationAlerts": {
        "enabled": true,
        "alertTypes": ["critical_bug", "payment_failure", "security_incident"],
        "channels": ["sms", "slack"]
      }
    },
    "teamAssignments": {
      "roles": [
        { "roleId": "role-ceo", "title": "CEO", "responsibilities": ["Final sign-off"], "cohortPhases": ["internal_beta", "closed_beta", "open_beta", "production_validation"], "escalationLevel": 3 },
        { "roleId": "role-qa", "title": "QA Lead", "responsibilities": ["Test execution"], "cohortPhases": ["internal_beta", "closed_beta"], "escalationLevel": 1 }
      ],
      "communicationChannels": {
        "primary": "slack",
        "escalation": "pagerduty",
        "documentation": "notion"
      }
    },
    "integrations": {
