      "campaignCalendar": { "schemaRef": "campaign_calendar.schema.json", "syncEnabled": true },
      "airtable": { "enabled": true, "tables": ["Beta_Cohorts", "Issues"] },
      "slack": { "enabled": true, "channels": ["#beta-ops", "#beta-feedback"] },
      "jira": { "enabled": true, "issueTypes": ["Bug", "Task"] }
    },
    "status": "active",
    "metadata": {
