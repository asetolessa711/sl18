  "qcPersonalizationTestCases": [
    {
      "description": "Personalization passes when brand consistency maintained",
      "personalization": {
        "recommendedPersona": { "personaId": "brand-approved-persona" },
        "recommendedContentStyle": { "tone": "casual" }
      },
      "brandGuidelines": {
        "approvedPersonas": ["brand-approved-persona", "other-approved"],
        "allowedTones": ["casual", "formal", "inspirational"]
      },
      "expectedPassed": true
    },
    {
      "description": "Personalization fails when persona not brand-approved",
      "personalization": {
        "recommendedPersona": { "personaId": "unapproved-persona" },
        "recommendedContentStyle": { "tone": "casual" }
      },
      "brandGuidelines": {
        "approvedPersonas": ["brand-approved-persona", "other-approved"],
        "allowedTones": ["casual", "formal"]
      },
      "expectedPassed": false,
      "expectedViolation": "persona_not_approved"
    },
    {
      "description": "Personalization fails when tone violates guidelines",
      "personalization": {
        "recommendedPersona": { "personaId": "brand-approved-persona" },
        "recommendedContentStyle": { "tone": "humorous" }
      },
      "brandGuidelines": {
        "approvedPersonas": ["brand-approved-persona"],
        "allowedTones": ["formal", "educational"]
      },
      "expectedPassed": false,
      "expectedViolation": "tone_not_allowed"
    },
    {
      "description": "Cultural sensitivity check passes for appropriate content",
      "personalization": {
        "region": "KE",
        "contentStyle": { "tone": "inspirational" }
      },
      "culturalRules": {
        "KE": { "forbiddenTones": ["controversial", "offensive"] }
      },
      "expectedPassed": true
    },
    {
      "description": "Cultural sensitivity check fails for inappropriate content",
      "personalization": {
        "region": "SA",
        "contentStyle": { "tone": "controversial" }
      },
      "culturalRules": {
        "SA": { "forbiddenTones": ["controversial", "offensive"] }
      },
      "expectedPassed": false,
      "expectedViolation": "cultural_sensitivity_violation"
    }
  ],
