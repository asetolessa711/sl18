  "pricingAdjustmentTestCases": [
    {
      "description": "Churn risk triggers discount offer",
      "input": {
        "churnRiskScore": 75,
        "currentTier": "premium",
        "region": "KE"
      },
      "expectedAdjustment": {
        "trigger": "churn_risk",
        "adjustmentType": "price_decrease",
        "suggestedValue": 20
      }
    },
    {
      "description": "High engagement triggers tier upgrade prompt",
      "input": {
        "engagementScore": 95,
        "currentTier": "basic",
        "watchTimeHours": 100
      },
      "expectedAdjustment": {
        "trigger": "engagement_drop",
        "adjustmentType": "tier_promotion"
      }
    },
    {
      "description": "Regional economics adjusts base price (factor = purchasingPowerIndex + 0.1 offset, clamped 0.1-1.0)",
      "input": {
        "basePrice": 10,
        "region": "ET",
        "purchasingPowerIndex": 0.45
      },
      "expectedAdjustedPrice": 5.5,
      "expectedFactor": 0.55,
      "calculationNote": "0.45 + 0.1 = 0.55, within bounds; adjustedPrice = 10 * 0.55 = 5.50"
    },
    {
      "description": "Seasonal promotion applies bundle offer",
      "input": {
        "currentDate": "2025-01-07T00:00:00Z",
        "promotionPeriod": {
          "start": "2025-01-01T00:00:00Z",
          "end": "2025-01-14T00:00:00Z"
        }
      },
      "expectedAdjustment": {
