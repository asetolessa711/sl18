  "continuityValidationTestCases": [
    {
      "description": "Persona consistency passes when voice profile matches",
      "persona": {
        "personaId": "persona-amara",
        "voiceProfile": { "tone": "Confident and warm" }
      },
      "episode1": { "personaTone": "Confident and warm" },
      "episode2": { "personaTone": "Confident and warm" },
      "expectedPassed": true
    },
    {
      "description": "Persona consistency fails when voice profile differs",
      "persona": {
        "personaId": "persona-kofi",
        "voiceProfile": { "tone": "Thoughtful and measured" }
      },
      "episode1": { "personaTone": "Thoughtful and measured" },
      "episode2": { "personaTone": "Aggressive and loud" },
      "expectedPassed": false
    },
    {
      "description": "Plot continuity passes when threads are consistent",
      "plotThread": {
        "threadId": "thread-funding",
        "status": "active"
      },
      "previousEpisode": { "threadMentioned": true, "threadStatus": "active" },
      "currentEpisode": { "threadMentioned": true, "threadStatus": "active" },
      "expectedPassed": true
    },
    {
      "description": "Plot continuity fails when resolved thread reappears as active",
      "plotThread": {
        "threadId": "thread-mystery",
        "status": "resolved"
      },
      "previousEpisode": { "threadMentioned": true, "threadStatus": "resolved" },
      "currentEpisode": { "threadMentioned": true, "threadStatus": "active" },
      "expectedPassed": false
    }
  ],
