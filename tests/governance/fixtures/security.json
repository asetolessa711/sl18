  "securityObservability": {
    "valid": [
      {
        "observabilityId": "secobs-sl18-global-v1",
        "version": "1.0.0",
        "name": "SL18 Global Security Observability",
        "dashboards": [
          {
            "dashboardId": "dash-security-overview",
            "name": "Security Overview",
            "type": "security_overview",
            "refreshInterval": 30,
            "widgets": [
              {
                "widgetId": "widget-security-score",
                "name": "Security Score",
                "type": "gauge",
                "dataSource": "security_metrics",
                "query": "SELECT security_score FROM metrics WHERE time > now() - 1h",
                "visualization": {
                  "thresholds": [
                    { "value": 0, "color": "#dc3545", "label": "Critical" },
                    { "value": 50, "color": "#ffc107", "label": "Warning" },
                    { "value": 80, "color": "#28a745", "label": "Good" }
                  ]
                }
              },
              {
                "widgetId": "widget-active-threats",
                "name": "Active Threats",
                "type": "metric",
                "dataSource": "threat_detection",
                "query": "SELECT COUNT(*) FROM threats WHERE status = 'active'"
              },
              {
                "widgetId": "widget-threat-timeline",
                "name": "Threat Timeline",
                "type": "timeline",
                "dataSource": "threat_detection",
                "query": "SELECT * FROM threats WHERE time > now() - 24h ORDER BY time DESC"
              },
              {
                "widgetId": "widget-incidents-chart",
                "name": "Incidents by Severity",
                "type": "chart",
                "dataSource": "incidents",
                "visualization": {
                  "chartType": "pie",
                  "colors": ["#dc3545", "#fd7e14", "#ffc107", "#28a745"]
                }
              }
            ],
            "filters": [
              {
                "field": "region",
                "type": "multi_select"
              },
              {
                "field": "time_range",
                "type": "date_range",
                "defaultValue": "24h"
              }
            ],
            "accessRoles": ["security_admin", "security_analyst", "ecosystem_admin"],
            "enabled": true
          },
          {
            "dashboardId": "dash-threat-landscape",
            "name": "Threat Landscape",
            "type": "threat_landscape",
            "refreshInterval": 60,
            "widgets": [
              {
                "widgetId": "widget-threat-map",
                "name": "Threat Geographic Distribution",
                "type": "map",
                "dataSource": "threat_detection"
