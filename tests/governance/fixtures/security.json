{
  "securityFrameworks": {
    "valid": [
      {
        "frameworkId": "secfw-sl18-global-v1",
        "version": "1.0.0",
        "name": "SL18 Global Security Framework",
        "scope": {
          "level": "global",
          "services": ["api", "web", "mobile", "data", "partner"],
          "regions": ["US", "EU", "APAC", "MEA", "LATAM"],
          "environments": ["production", "staging", "development"]
        },
        "encryptionStandards": {
          "dataAtRest": {
            "algorithm": "AES-256-GCM",
            "keyLength": 256,
            "keyRotationDays": 90,
            "keyManagement": "aws_kms"
          },
          "dataInTransit": {
            "protocol": "TLS_1_3",
            "minimumTlsVersion": "1.3",
            "cipherSuites": [
              "TLS_AES_256_GCM_SHA384",
              "TLS_CHACHA20_POLY1305_SHA256",
              "TLS_AES_128_GCM_SHA256"
            ],
            "certificateType": "ev_ssl",
            "certificateProvider": "DigiCert",
            "hsts": {
              "enabled": true,
              "maxAge": 31536000,
              "includeSubdomains": true,
              "preload": true
            }
          },
          "fieldLevelEncryption": {
            "enabled": true,
            "sensitiveFields": ["ssn", "payment_card", "bank_account", "password", "api_key"],
            "tokenization": {
              "enabled": true,
              "format": "uuid"
            }
          }
        },
        "accessControl": {
          "model": "rbac",
          "authentication": {
            "methods": ["password", "mfa_totp", "mfa_push", "sso_oidc", "api_key", "jwt"],
            "mfaRequired": true,
            "mfaContextual": {
              "enabled": true,
              "triggers": ["new_device", "new_location", "high_risk_action", "failed_attempts"],
              "riskThreshold": 70
            },
            "passwordPolicy": {
              "minLength": 12,
              "requireUppercase": true,
              "requireLowercase": true,
              "requireNumbers": true,
              "requireSymbols": true,
              "expirationDays": 90,
              "historyCount": 12,
              "lockoutThreshold": 5,
              "lockoutDuration": 30
            },
            "sessionPolicy": {
              "maxDuration": 480,
              "idleTimeout": 30,
              "concurrentSessions": 3,
              "deviceBinding": true,
              "geoBinding": false
            }
          },
          "authorization": {
            "roles": [
              {
                "roleId": "role-security-admin",
                "name": "Security Administrator",
                "permissions": [
                  "view_policies",
                  "create_policies",
                  "edit_policies",
                  "delete_policies",
                  "approve_policies",
                  "enforce_policies",
                  "view_compliance",
                  "manage_compliance",
                  "view_audit_logs",
                  "export_audit_logs",
                  "manage_roles",
                  "block_content",
                  "suspend_accounts"
                ],
                "mfaRequired": true,
                "approvalRequired": false
              },
              {
                "roleId": "role-security-analyst",
                "name": "Security Analyst",
                "permissions": [
                  "view_policies",
                  "view_compliance",
                  "view_audit_logs",
                  "export_audit_logs"
                ],
                "mfaRequired": true,
                "approvalRequired": false
              },
              {
                "roleId": "role-incident-responder",
                "name": "Incident Responder",
                "permissions": [
                  "view_policies",
                  "view_audit_logs",
                  "block_content",
                  "suspend_accounts"
                ],
                "constraints": {
                  "timeWindows": [
                    {
                      "dayOfWeek": [0, 1, 2, 3, 4, 5, 6],
                      "startHour": 0,
                      "endHour": 23
                    }
                  ]
                },
                "mfaRequired": true,
                "approvalRequired": true
              }
            ],
            "policies": [
              {
                "policyId": "pol-admin-access",
                "name": "Admin Access Policy",
                "resource": "/admin/*",
                "actions": ["read", "write", "create", "delete", "admin"],
                "effect": "allow",
                "conditions": [
                  {
                    "attribute": "role",
                    "operator": "in",
                    "value": ["security_admin", "ecosystem_admin"]
                  },
                  {
                    "attribute": "mfa_verified",
                    "operator": "eq",
                    "value": true
                  }
                ]
              },
              {
                "policyId": "pol-api-access",
                "name": "API Access Policy",
                "resource": "/api/*",
                "actions": ["read", "write", "create"],
                "effect": "allow",
                "conditions": [
                  {
                    "attribute": "api_key_valid",
                    "operator": "eq",
                    "value": true
                  }
                ]
              }
            ]
          }
        },
        "zeroTrust": {
          "enabled": true,
          "principles": [
            "never_trust_always_verify",
            "least_privilege",
            "assume_breach",
            "verify_explicitly",
            "continuous_validation",
            "micro_segmentation"
          ],
          "networkSegmentation": {
            "enabled": true,
            "segments": [
              {
                "segmentId": "seg-public",
                "name": "Public Services",
                "services": ["api-gateway", "cdn"],
                "allowedConnections": ["seg-application"]
              },
              {
                "segmentId": "seg-application",
                "name": "Application Services",
                "services": ["web-app", "mobile-backend", "partner-api"],
                "allowedConnections": ["seg-data", "seg-security"]
              },
              {
                "segmentId": "seg-data",
                "name": "Data Services",
                "services": ["database", "cache", "storage"],
                "allowedConnections": []
              },
              {
                "segmentId": "seg-security",
                "name": "Security Services",
                "services": ["auth", "vault", "logging"],
                "allowedConnections": ["seg-application", "seg-data"]
              }
            ]
          },
          "deviceTrust": {
            "enabled": true,
            "complianceChecks": ["os_version", "security_patches", "antivirus", "disk_encryption", "screen_lock"],
            "minimumTrustScore": 80
          },
          "identityVerification": {
            "continuousAuth": true,
            "behavioralAnalysis": true,
            "riskScoring": true,
            "stepUpAuth": {
              "enabled": true,
              "triggers": ["sensitive_data", "financial_action", "admin_action", "high_risk_score"]
            }
          }
        },
        "credentialManagement": {
          "vault": {
            "provider": "hashicorp_vault",
            "enabled": true,
            "autoRotation": true,
            "rotationInterval": 30
          },
          "apiKeys": {
            "format": "prefixed",
            "expirationDays": 90,
            "rateLimiting": {
              "enabled": true,
              "requestsPerMinute": 1000,
              "requestsPerHour": 10000
            }
          },
          "serviceAccounts": {
            "minimumPrivilege": true,
            "rotationRequired": true,
            "auditRequired": true
          }
        },
        "compliance": {
          "frameworks": ["SOC2", "ISO27001", "GDPR", "PCI_DSS"],
          "lastAudit": "2024-09-15T00:00:00Z",
          "nextAudit": "2025-03-15T00:00:00Z",
          "certifications": [
            {
              "name": "SOC 2 Type II",
              "issueDate": "2024-09-15",
              "expirationDate": "2025-09-15",
              "status": "active"
            },
            {
              "name": "ISO 27001",
              "issueDate": "2024-06-01",
              "expirationDate": "2027-06-01",
              "status": "active"
            }
          ]
        },
        "metrics": {
          "securityScore": 94,
          "vulnerabilitiesOpen": 3,
          "vulnerabilitiesClosed": 127,
          "incidentsThisMonth": 2,
          "meanTimeToDetect": 15,
          "meanTimeToRespond": 45,
          "complianceScore": 98,
          "lastUpdated": "2024-11-28T04:00:00Z"
        },
        "status": "active",
        "createdAt": "2024-01-01T00:00:00Z",
        "updatedAt": "2024-11-28T04:00:00Z",
        "createdBy": "security-admin-001"
      }
    ],
