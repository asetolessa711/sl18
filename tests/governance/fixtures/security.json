  "threatDetection": {
    "valid": [
      {
        "detectionId": "threat-sl18-global-v1",
        "version": "1.0.0",
        "name": "SL18 Global Threat Detection",
        "scope": {
          "level": "global",
          "services": ["api", "web", "mobile", "partner"],
          "regions": ["US", "EU", "APAC", "MEA", "LATAM"]
        },
        "threatCategories": [
          {
            "categoryId": "cat-fraud",
            "name": "Financial Fraud",
            "type": "fraud",
            "severity": "critical",
            "indicators": [
              {
                "indicatorId": "ind-velocity",
                "name": "Transaction Velocity Anomaly",
                "type": "transactional",
                "description": "Unusual number of transactions in short time",
                "weight": 0.8
              },
              {
                "indicatorId": "ind-amount",
                "name": "Unusual Transaction Amount",
                "type": "transactional",
                "description": "Transaction amount significantly differs from baseline",
                "weight": 0.7
              },
              {
                "indicatorId": "ind-geo",
                "name": "Geographic Anomaly",
                "type": "geographic",
                "description": "Transaction from unexpected location",
                "weight": 0.6
              }
            ],
            "enabled": true
          },
          {
            "categoryId": "cat-ato",
            "name": "Account Takeover",
            "type": "account_takeover",
            "severity": "critical",
            "indicators": [
              {
                "indicatorId": "ind-credential-stuff",
                "name": "Credential Stuffing Pattern",
                "type": "behavioral",
                "description": "Multiple failed logins followed by success",
                "weight": 0.9
              },
              {
                "indicatorId": "ind-device-change",
                "name": "Device Change After Login",
                "type": "identity",
                "description": "Account accessed from new device post-login",
                "weight": 0.7
              }
            ],
            "enabled": true
          },
          {
            "categoryId": "cat-bot",
            "name": "Bot Abuse",
            "type": "bot_abuse",
            "severity": "high",
            "indicators": [
              {
                "indicatorId": "ind-rate",
                "name": "Request Rate Anomaly",
                "type": "network",
                "description": "Abnormally high request rate",
                "weight": 0.8
              },
              {
                "indicatorId": "ind-pattern",
                "name": "Non-Human Pattern",
                "type": "behavioral",
                "description": "Interaction patterns indicate automation",
                "weight": 0.75
              }
            ],
            "enabled": true
          },
          {
            "categoryId": "cat-api-misuse",
            "name": "API Misuse",
            "type": "api_misuse",
            "severity": "high",
            "indicators": [
              {
                "indicatorId": "ind-quota",
                "name": "Quota Abuse",
                "type": "transactional",
                "description": "Attempts to exceed API quotas",
                "weight": 0.7
              },
              {
                "indicatorId": "ind-scraping",
                "name": "Data Scraping Pattern",
                "type": "behavioral",
                "description": "Systematic data extraction attempts",
                "weight": 0.85
              }
            ],
            "enabled": true
          },
          {
            "categoryId": "cat-insider",
            "name": "Insider Risk",
            "type": "insider_risk",
            "severity": "high",
            "indicators": [
              {
                "indicatorId": "ind-bulk-access",
                "name": "Bulk Data Access",
                "type": "behavioral",
                "description": "Unusual volume of data access",
                "weight": 0.8
              },
              {
                "indicatorId": "ind-offhours",
                "name": "Off-Hours Activity",
                "type": "temporal",
                "description": "Activity during unusual hours",
                "weight": 0.5
              }
            ],
            "enabled": true
          }
        ],
        "detectionRules": [
          {
            "ruleId": "rule-velocity-spike",
            "name": "Transaction Velocity Spike",
            "description": "Detect sudden increase in transaction frequency",
            "category": "cat-fraud",
            "type": "threshold",
            "condition": {
              "metric": "transaction_count",
              "operator": "gt",
              "value": 10,
              "timeWindow": 60,
              "aggregation": "count"
            },
            "severity": "high",
            "actions": ["alert", "throttle", "notify"],
            "cooldownPeriod": 300,
            "enabled": true,
            "priority": 1
          },
          {
            "ruleId": "rule-credential-stuffing",
            "name": "Credential Stuffing Detection",
            "description": "Detect credential stuffing attacks",
            "category": "cat-ato",
            "type": "pattern",
            "condition": {
              "metric": "failed_logins_same_ip",
              "operator": "gt",
              "value": 5,
              "timeWindow": 60,
              "aggregation": "count"
            },
            "severity": "critical",
            "actions": ["block", "alert", "capture_evidence", "notify"],
            "cooldownPeriod": 600,
            "enabled": true,
            "priority": 1
          },
          {
            "ruleId": "rule-bot-detection",
            "name": "Bot Traffic Detection",
            "description": "Detect automated bot traffic",
            "category": "cat-bot",
            "type": "anomaly",
            "condition": {
              "metric": "request_rate_per_session",
              "operator": "gt",
              "value": 100,
              "timeWindow": 60,
              "aggregation": "rate"
            },
            "severity": "medium",
            "actions": ["throttle", "alert"],
            "cooldownPeriod": 120,
            "enabled": true,
            "priority": 2
          },
          {
            "ruleId": "rule-data-exfil",
            "name": "Data Exfiltration Detection",
            "description": "Detect potential data exfiltration",
            "category": "cat-insider",
            "type": "ml_model",
            "condition": {
              "metric": "data_download_volume",
              "operator": "gt",
              "value": 1000000000,
              "timeWindow": 3600,
              "aggregation": "sum"
            },
            "severity": "critical",
            "actions": ["alert", "block", "escalate", "capture_evidence"],
            "cooldownPeriod": 0,
            "enabled": true,
            "priority": 1
          }
        ],
        "anomalyDetection": {
          "enabled": true,
          "behavioral": {
            "enabled": true,
            "metrics": [
              "login_frequency",
              "session_duration",
              "action_patterns",
              "api_usage_patterns",
              "data_access_patterns",
              "time_of_activity"
            ],
            "baselinePeriod": 30,
            "sensitivityLevel": "high"
          },
          "transactional": {
            "enabled": true,
            "metrics": [
              "transaction_velocity",
              "transaction_amount",
              "transaction_frequency",
              "payment_method_changes",
              "geographic_spread"
            ],
            "thresholds": {
              "velocityLimit": 50,
              "amountLimit": 10000,
              "dailyLimit": 50000
            }
          },
          "network": {
            "enabled": true,
            "metrics": [
              "request_rate",
              "bandwidth_usage",
              "connection_patterns",
              "geographic_anomalies"
            ]
          }
        },
        "mlModels": {
          "enabled": true,
          "models": [
            {
              "modelId": "ml-fraud-v3",
              "name": "Fraud Detection Neural Network",
              "type": "neural_network",
