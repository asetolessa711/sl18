            "triggerSeverity": ["high"],
            "steps": [
              {
                "stepId": "step-1",
                "order": 1,
                "action": "throttle_rate",
                "parameters": {
                  "reduction": 0.5
                },
                "delay": 0
              },
              {
                "stepId": "step-2",
                "order": 2,
                "action": "log_forensic",
                "delay": 0
              },
              {
                "stepId": "step-3",
                "order": 3,
                "action": "create_incident",
                "parameters": {
                  "severity": "high"
                },
                "delay": 0
              },
              {
                "stepId": "step-4",
                "order": 4,
                "action": "notify_security",
                "parameters": {
                  "channels": ["slack", "email"]
                },
                "delay": 5
              }
            ],
            "escalation": {
              "enabled": true,
              "timeout": 30,
              "path": ["security_analyst", "security_admin"]
            },
            "sla": {
              "responseTime": 15,
              "resolutionTime": 240
            },
            "enabled": true
          }
        ],
