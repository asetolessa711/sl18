                "thresholds": {
                  "low": 20,
                  "medium": 50,
                  "high": 75,
                  "critical": 90
                }
              }
            ],
            "overallThresholds": {
              "block": 90,
              "mfaRequired": 70,
              "alert": 50,
              "log": 30
            }
          }
        },
        "responseWorkflows": [
          {
            "workflowId": "wf-critical-threat",
            "name": "Critical Threat Response",
            "triggerCategories": ["cat-fraud", "cat-ato"],
            "triggerSeverity": ["critical"],
            "steps": [
              {
                "stepId": "step-1",
                "order": 1,
                "action": "block_request",
                "delay": 0
              },
              {
                "stepId": "step-2",
                "order": 2,
                "action": "capture_evidence",
                "delay": 0
              },
              {
                "stepId": "step-3",
                "order": 3,
                "action": "create_incident",
                "parameters": {
                  "severity": "critical",
                  "autoAssign": true
                },
                "delay": 0
              },
              {
                "stepId": "step-4",
                "order": 4,
                "action": "notify_security",
                "parameters": {
                  "channels": ["pagerduty", "slack"]
                },
                "delay": 0
              },
              {
                "stepId": "step-5",
                "order": 5,
                "action": "require_mfa",
                "delay": 60,
                "condition": "user.session_active == true"
              }
            ],
            "escalation": {
              "enabled": true,
              "timeout": 15,
              "path": ["security_analyst", "security_admin", "ciso"]
            },
            "sla": {
              "responseTime": 5,
              "resolutionTime": 60
            },
            "enabled": true
          },
          {
            "workflowId": "wf-high-threat",
            "name": "High Threat Response",
