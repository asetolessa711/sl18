              "version": "3.2.1",
              "accuracy": 0.97,
              "lastTrained": "2024-11-01T00:00:00Z",
              "enabled": true
            },
            {
              "modelId": "ml-ato-v2",
              "name": "Account Takeover Classifier",
              "type": "classification",
              "purpose": "account_takeover",
              "version": "2.1.0",
              "accuracy": 0.95,
              "lastTrained": "2024-10-15T00:00:00Z",
              "enabled": true
            },
            {
              "modelId": "ml-bot-v1",
              "name": "Bot Detection Ensemble",
              "type": "ensemble",
              "purpose": "bot_detection",
              "version": "1.5.0",
              "accuracy": 0.92,
              "lastTrained": "2024-11-10T00:00:00Z",
              "enabled": true
            }
          ],
          "riskScoring": {
            "enabled": true,
            "factors": [
              {
                "factorId": "factor-velocity",
                "name": "Transaction Velocity",
                "weight": 0.25,
                "thresholds": {
                  "low": 20,
                  "medium": 50,
                  "high": 80,
                  "critical": 95
                }
              },
              {
                "factorId": "factor-behavior",
                "name": "Behavioral Anomaly",
                "weight": 0.3,
                "thresholds": {
                  "low": 30,
                  "medium": 60,
                  "high": 85,
                  "critical": 95
                }
              },
              {
                "factorId": "factor-device",
