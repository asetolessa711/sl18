      "description": "Type of governance event"
    },
    "category": {
      "type": "string",
      "enum": ["registration", "agreement", "revenue", "qc", "publishing", "system", "payment", "globalization", "observability", "series", "hybrid", "personalization", "monetization", "governance", "access_control", "compliance", "contributor", "marketplace", "distribution", "syndication", "partner", "audience_insights", "feedback_loop", "ui", "ai_assistant", "voice_control", "partner_ecosystem", "api_marketplace", "governance_suite", "payment_compliance", "cultural_qc"],
      "description": "Category of the audit event"
    },
    "actor": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["user", "system", "automation"],
          "description": "Type of actor"
        },
        "id": {
          "type": "string",
          "description": "Actor identifier"
        },
        "name": {
          "type": "string",
          "description": "Actor display name"
        }
      },
      "required": ["type", "id"],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["franchise", "agreement", "ledger", "episode", "content", "payment", "workspace", "language_pack", "incident", "series", "pipeline", "alert", "viewer", "subscription", "pricing", "policy", "role", "permission", "contributor", "listing", "marketplace", "promotion", "distribution_channel", "syndication_feed", "partner_integration", "audience_insight", "feedback_loop", "engagement_metric", "sentiment_analysis", "retention_curve", "console", "dashboard", "panel", "widget", "assistant", "voice_control", "voice_command", "recommendation", "ecosystem_partner", "api_listing", "api_subscription", "api_key", "api_webhook", "api_quota", "governance_suite", "payment_compliance", "cultural_qc_check", "kyc_document", "aml_screening", "tax_compliance", "fraud_signal", "cultural_rule", "remediation_workflow", "violation", "appeal"],
          "description": "Type of target entity"
        },
        "id": {
          "type": "string",
          "description": "Target entity identifier"
        },
        "franchiseId": {
          "type": "string",
          "description": "Associated franchise ID (if applicable)"
        }
      },
      "required": ["type", "id"],
      "additionalProperties": false
    },
    "details": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "description": "Human-readable description of the event"
        },
        "previousValue": {
          "description": "Previous value (for change events)"
        },
        "newValue": {
          "description": "New value (for change events)"
        },
        "reason": {
          "type": "string",
          "description": "Reason for the action"
        },
        "metadata": {
          "type": "object",
          "description": "Additional metadata",
          "additionalProperties": true
        }
      },
      "required": ["description"],
      "additionalProperties": false
    },
    "result": {
      "type": "string",
      "enum": ["success", "failure", "pending", "partial"],
      "description": "Result of the action"
    },
    "correlationId": {
      "type": "string",
      "description": "ID to correlate related audit entries"
    },
    "ipAddress": {
      "type": "string",
      "description": "IP address of the actor (if applicable)"
    }
  },
  "required": [
    "logId",
    "timestamp",
    "eventType",
    "category",
    "actor",
    "target",
    "details",
    "result"
  ],
  "additionalProperties": false
