{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GovernanceAuditLog",
  "description": "Schema for governance audit log entries in SL18",
  "type": "object",
  "properties": {
    "logId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 100,
      "description": "Unique audit log entry identifier"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the event"
    },
    "eventType": {
      "type": "string",
      "enum": [
        "registration_submitted",
        "registration_approved",
        "registration_rejected",
        "registration_suspended",
        "registration_terminated",
        "agreement_created",
        "agreement_signed",
        "agreement_amended",
        "agreement_terminated",
        "revenue_recorded",
        "revenue_split_calculated",
        "payout_scheduled",
        "payout_approved",
        "payout_completed",
        "payout_failed",
        "qc_submitted",
        "qc_approved",
        "qc_rejected",
        "qc_strike_issued",
        "content_published",
        "content_rollback",
        "override_applied",
        "credential_rotated",
        "system_alert"
      ],
      "description": "Type of governance event"
    },
    "category": {
      "type": "string",
      "enum": ["registration", "agreement", "revenue", "qc", "publishing", "system"],
      "description": "Category of the audit event"
    },
    "actor": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["user", "system", "automation"],
          "description": "Type of actor"
        },
        "id": {
          "type": "string",
          "description": "Actor identifier"
        },
        "name": {
          "type": "string",
          "description": "Actor display name"
        }
      },
      "required": ["type", "id"],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["franchise", "agreement", "ledger", "episode", "content"],
          "description": "Type of target entity"
        },
        "id": {
          "type": "string",
          "description": "Target entity identifier"
        },
        "franchiseId": {
          "type": "string",
          "description": "Associated franchise ID (if applicable)"
        }
      },
      "required": ["type", "id"],
      "additionalProperties": false
    },
    "details": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "description": "Human-readable description of the event"
        },
        "previousValue": {
          "description": "Previous value (for change events)"
        },
        "newValue": {
          "description": "New value (for change events)"
        },
        "reason": {
          "type": "string",
          "description": "Reason for the action"
        },
        "metadata": {
          "type": "object",
          "description": "Additional metadata",
          "additionalProperties": true
        }
      },
      "required": ["description"],
      "additionalProperties": false
    },
    "result": {
      "type": "string",
      "enum": ["success", "failure", "pending", "partial"],
      "description": "Result of the action"
    },
    "correlationId": {
      "type": "string",
      "description": "ID to correlate related audit entries"
    },
    "ipAddress": {
      "type": "string",
      "description": "IP address of the actor (if applicable)"
    }
  },
  "required": [
    "logId",
    "timestamp",
    "eventType",
    "category",
    "actor",
    "target",
    "details",
    "result"
  ],
  "additionalProperties": false
}
