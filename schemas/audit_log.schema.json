{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GovernanceAuditLog",
  "description": "Schema for governance audit log entries in SL18",
  "type": "object",
  "properties": {
    "logId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 100,
      "description": "Unique audit log entry identifier"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the event"
    },
    "eventType": {
      "type": "string",
      "enum": [
        "registration_submitted",
        "registration_approved",
        "registration_rejected",
        "registration_suspended",
        "registration_terminated",
        "agreement_created",
        "agreement_signed",
        "agreement_amended",
        "agreement_terminated",
        "revenue_recorded",
        "revenue_split_calculated",
        "payout_scheduled",
        "payout_approved",
        "payout_completed",
        "payout_failed",
        "qc_submitted",
        "qc_approved",
        "qc_rejected",
        "qc_strike_issued",
        "content_published",
        "content_rollback",
        "override_applied",
        "credential_rotated",
        "system_alert",
        "payment_initiated",
        "payment_completed",
        "payment_failed",
        "payment_refunded",
        "payment_disputed",
        "fraud_detected",
        "workspace_provisioned",
        "workspace_suspended",
        "language_pack_added",
        "language_pack_removed",
        "translation_submitted",
        "translation_approved",
        "translation_rejected",
        "multilingual_qc_passed",
        "multilingual_qc_failed",
        "anomaly_detected",
        "incident_created",
        "incident_acknowledged",
        "incident_resolved",
        "incident_closed",
        "alert_triggered",
        "alert_escalated",
        "alert_resolved",
        "diagnostics_started",
        "diagnostics_completed",
        "series_created",
        "series_updated",
        "episode_created",
        "episode_published",
        "continuity_check_passed",
        "continuity_check_failed",
        "hybrid_pipeline_started",
        "hybrid_pipeline_completed",
        "cross_format_qc_passed",
        "cross_format_qc_failed",
        "personalization_served",
        "personalization_updated",
        "recommendation_generated",
        "adaptive_rendering_applied",
        "qc_personalization_passed",
        "qc_personalization_failed",
        "pricing_adjusted",
        "tier_upgraded",
        "tier_downgraded",
        "subscription_created",
        "subscription_renewed",
        "subscription_cancelled",
        "churn_risk_detected",
        "retention_action_triggered",
        "dynamic_discount_applied",
        "revenue_optimization_applied",
        "policy_created",
        "policy_updated",
        "policy_activated",
        "policy_suspended",
        "policy_deprecated",
        "policy_violation_detected",
        "compliance_check_passed",
        "compliance_check_failed",
        "role_assigned",
        "role_revoked",
        "permission_granted",
        "permission_revoked",
        "mfa_enabled",
        "mfa_disabled",
        "sensitive_action_attempted",
        "audit_started",
        "audit_completed",
        "contributor_registered",
        "contributor_verified",
        "contributor_agreement_signed",
        "contributor_agreement_amended",
        "contributor_suspended",
        "contributor_reinstated",
        "contributor_terminated",
        "listing_created",
        "listing_approved",
        "listing_featured",
        "listing_suspended",
        "listing_removed",
        "marketplace_transaction_initiated",
        "marketplace_transaction_completed",
        "marketplace_transaction_failed",
        "marketplace_payout_scheduled",
        "marketplace_payout_completed",
        "cross_promotion_created",
        "cross_promotion_approved",
        "distribution_started",
        "distribution_completed",
        "distribution_failed",
        "distribution_retried",
        "distribution_cancelled",
        "channel_created",
        "channel_updated",
        "channel_activated",
        "channel_deactivated",
        "channel_health_check",
        "syndication_feed_created",
        "syndication_feed_updated",
        "syndication_feed_published",
        "syndication_feed_error",
        "syndication_item_added",
        "syndication_item_removed",
        "partner_integration_created",
        "partner_integration_updated",
        "partner_integration_activated",
        "partner_integration_deactivated",
        "partner_integration_failed",
        "partner_api_call",
        "partner_webhook_received",
        "partner_credential_rotated",
        "regional_compliance_check_passed",
        "regional_compliance_check_failed",
        "geo_restriction_applied",
        "licensing_agreement_created",
        "licensing_agreement_expired",
        "insight_collected",
        "insight_processed",
        "insight_ready",
        "engagement_metrics_updated",
        "sentiment_analysis_completed",
        "retention_curve_generated",
        "demographic_breakdown_updated",
        "feedback_loop_triggered",
        "feedback_loop_action_executed",
        "feedback_loop_action_failed",
        "feedback_loop_rollback",
        "personalization_adjusted",
        "monetization_signal_detected",
        "qc_feedback_generated",
        "cultural_sensitivity_alert",
        "translation_quality_flagged",
        "persona_consistency_flagged",
        "churn_action_triggered",
        "upgrade_potential_detected",
        "binge_pattern_detected",
        "retention_drop_detected",
        "regional_performance_alert"
      ],
      "description": "Type of governance event"
    },
    "category": {
      "type": "string",
      "enum": ["registration", "agreement", "revenue", "qc", "publishing", "system", "payment", "globalization", "observability", "series", "hybrid", "personalization", "monetization", "governance", "access_control", "compliance", "contributor", "marketplace", "distribution", "syndication", "partner", "audience_insights", "feedback_loop"],
      "description": "Category of the audit event"
    },
    "actor": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["user", "system", "automation"],
          "description": "Type of actor"
        },
        "id": {
          "type": "string",
          "description": "Actor identifier"
        },
        "name": {
          "type": "string",
          "description": "Actor display name"
        }
      },
      "required": ["type", "id"],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["franchise", "agreement", "ledger", "episode", "content", "payment", "workspace", "language_pack", "incident", "series", "pipeline", "alert", "viewer", "subscription", "pricing", "policy", "role", "permission", "contributor", "listing", "marketplace", "promotion", "distribution_channel", "syndication_feed", "partner_integration", "audience_insight", "feedback_loop", "engagement_metric", "sentiment_analysis", "retention_curve"],
          "description": "Type of target entity"
        },
        "id": {
          "type": "string",
          "description": "Target entity identifier"
        },
        "franchiseId": {
          "type": "string",
          "description": "Associated franchise ID (if applicable)"
        }
      },
      "required": ["type", "id"],
      "additionalProperties": false
    },
    "details": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "description": "Human-readable description of the event"
        },
        "previousValue": {
          "description": "Previous value (for change events)"
        },
        "newValue": {
          "description": "New value (for change events)"
        },
        "reason": {
          "type": "string",
          "description": "Reason for the action"
        },
        "metadata": {
          "type": "object",
          "description": "Additional metadata",
          "additionalProperties": true
        }
      },
      "required": ["description"],
      "additionalProperties": false
    },
    "result": {
      "type": "string",
      "enum": ["success", "failure", "pending", "partial"],
      "description": "Result of the action"
    },
    "correlationId": {
      "type": "string",
      "description": "ID to correlate related audit entries"
    },
    "ipAddress": {
      "type": "string",
      "description": "IP address of the actor (if applicable)"
    }
  },
  "required": [
    "logId",
    "timestamp",
    "eventType",
    "category",
    "actor",
    "target",
    "details",
    "result"
  ],
  "additionalProperties": false
}
