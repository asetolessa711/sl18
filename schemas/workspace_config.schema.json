{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkspaceConfig",
  "description": "Schema for workspace configuration with language support in SL18 globalization layer",
  "type": "object",
  "properties": {
    "workspaceId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 50,
      "description": "Unique workspace identifier"
    },
    "franchiseId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 50,
      "pattern": "^[a-z][a-z0-9_-]*$",
      "description": "Associated franchise"
    },
    "displayName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100,
      "description": "Workspace display name"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Enabled languages for this workspace (e.g., ['en', 'fr', 'es', 'ar', 'zh-CN'])"
    },
    "primaryLanguage": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
      "description": "Primary language for content creation"
    },
    "translationSettings": {
      "type": "object",
      "properties": {
        "autoTranslate": {
          "type": "boolean",
          "default": false,
          "description": "Whether to auto-translate content"
        },
        "translationProvider": {
          "type": "string",
          "enum": ["google", "deepl", "azure", "manual"],
          "description": "Translation service provider"
        },
        "requireHumanReview": {
          "type": "boolean",
          "default": true,
          "description": "Whether human review is required after auto-translation"
        }
      },
      "additionalProperties": false
    },
    "paymentSettings": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Whether payments are enabled"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "default": "USD",
          "description": "Default currency"
        },
        "acceptedGateways": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["visa", "mastercard", "paypal", "stripe", "bank_transfer"]
          },
          "description": "Accepted payment gateways"
        },
        "autoProvisionOnPayment": {
          "type": "boolean",
          "default": true,
          "description": "Whether to auto-provision workspace after payment"
        }
      },
      "additionalProperties": false
    },
    "qcSettings": {
      "type": "object",
      "properties": {
        "multilingualQcEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether multilingual QC is enabled"
        },
        "translationAccuracyThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 95,
          "description": "Minimum translation accuracy"
        },
        "requireNativeReview": {
          "type": "boolean",
          "default": false,
          "description": "Whether native speaker review is required"
        },
        "culturalReviewEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether cultural review is enabled"
        }
      },
      "additionalProperties": false
    },
    "provisioningStatus": {
      "type": "string",
      "enum": ["pending_payment", "provisioning", "active", "suspended", "terminated"],
      "description": "Workspace provisioning status"
    },
    "provisionedAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "When workspace was provisioned"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "When workspace config was created"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When workspace config was last updated"
    }
  },
  "required": [
    "workspaceId",
    "franchiseId",
    "displayName",
    "languages",
    "primaryLanguage",
    "provisioningStatus",
    "createdAt"
  ],
  "additionalProperties": false
}
