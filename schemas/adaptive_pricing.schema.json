{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AdaptivePricing",
  "description": "Schema for AI-driven adaptive pricing and monetization models in SL18",
  "type": "object",
  "properties": {
    "pricingId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 100,
      "description": "Unique adaptive pricing configuration identifier"
    },
    "franchiseId": {
      "type": "string",
      "description": "Associated franchise identifier"
    },
    "region": {
      "type": "string",
      "description": "Geographic region for pricing (ISO 3166-1 alpha-2)"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "Currency code (ISO 4217)"
    },
    "viewerTier": {
      "type": "object",
      "properties": {
        "tierId": {
          "type": "string",
          "description": "Viewer tier identifier"
        },
        "tierName": {
          "type": "string",
          "enum": ["free", "basic", "premium", "vip", "enterprise"],
          "description": "Tier level name"
        },
        "tierFeatures": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Features available in this tier"
        },
        "adsEnabled": {
          "type": "boolean",
          "description": "Whether ads are shown for this tier"
        },
        "offlineAccess": {
          "type": "boolean",
          "description": "Whether offline access is available"
        },
        "qualityLimit": {
          "type": "string",
          "enum": ["sd", "hd", "full_hd", "4k"],
          "description": "Maximum video quality for this tier"
        }
      },
      "required": ["tierId", "tierName"],
      "additionalProperties": false
    },
    "priceModel": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["subscription", "pay_per_view", "freemium", "ad_supported", "hybrid"],
          "description": "Primary monetization model"
        },
        "basePrice": {
          "type": "number",
          "minimum": 0,
          "description": "Base price in the specified currency"
        },
        "billingCycle": {
          "type": "string",
          "enum": ["one_time", "daily", "weekly", "monthly", "quarterly", "yearly"],
          "description": "Billing frequency"
        },
        "trialPeriod": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "durationDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90
            },
            "trialTier": { "type": "string" }
          },
          "additionalProperties": false
        },
        "discounts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "discountId": { "type": "string" },
              "type": {
                "type": "string",
                "enum": ["percentage", "fixed", "bundle"]
              },
              "value": { "type": "number" },
              "conditions": {
                "type": "object",
                "properties": {
                  "minSubscriptionMonths": { "type": "integer" },
                  "loyaltyPoints": { "type": "integer" },
                  "referralCode": { "type": "string" },
                  "regionSpecific": { "type": "boolean" }
                },
                "additionalProperties": false
              },
              "validFrom": { "type": "string", "format": "date-time" },
              "validUntil": { "type": "string", "format": "date-time" }
            },
            "required": ["discountId", "type", "value"],
            "additionalProperties": false
          }
        }
      },
      "required": ["type", "basePrice"],
      "additionalProperties": false
    },
    "revenueOptimization": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether AI-driven revenue optimization is enabled"
        },
        "engagementFactors": {
          "type": "object",
          "properties": {
            "watchTimeWeight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Weight of watch time in optimization"
            },
            "interactionWeight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Weight of user interactions"
            },
            "completionRateWeight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Weight of content completion rate"
            }
          },
          "additionalProperties": false
        },
        "churnPrediction": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "riskScore": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Current churn risk score"
            },
            "riskLevel": {
              "type": "string",
              "enum": ["low", "medium", "high", "critical"]
            },
            "retentionActions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "actionType": {
                    "type": "string",
                    "enum": ["discount_offer", "content_recommendation", "tier_upgrade_prompt", "personal_outreach", "loyalty_reward"]
                  },
                  "priority": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "description": { "type": "string" }
                },
                "required": ["actionType", "priority"],
                "additionalProperties": false
              }
            },
            "lastAssessedAt": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": false
        },
        "regionalEconomics": {
          "type": "object",
          "properties": {
            "purchasingPowerIndex": {
              "type": "number",
              "minimum": 0,
              "description": "Regional purchasing power index"
            },
            "localizedPricing": {
              "type": "boolean",
              "description": "Whether to apply localized pricing adjustments"
            },
            "priceAdjustmentFactor": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 3.0,
              "description": "Multiplier applied to base price for region. Minimum 0.1 (10% of base) ensures minimum viable revenue. Maximum 3.0 (300% of base) allows for premium pricing in high purchasing power regions while preventing excessive pricing that could harm adoption."
            },
            "lastUpdatedAt": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": false
        },
        "dynamicAdjustments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "adjustmentId": { "type": "string" },
              "trigger": {
                "type": "string",
                "enum": ["engagement_drop", "churn_risk", "competitive_pressure", "seasonal", "promotional"]
              },
              "adjustmentType": {
                "type": "string",
                "enum": ["price_decrease", "price_increase", "tier_promotion", "feature_unlock", "bundle_offer"]
              },
              "value": { "type": "number" },
              "appliedAt": { "type": "string", "format": "date-time" },
              "expiresAt": { "type": "string", "format": "date-time" },
              "reasoning": { "type": "string" }
            },
            "required": ["adjustmentId", "trigger", "adjustmentType", "value"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "revenueLedgerIntegration": {
      "type": "object",
      "properties": {
        "ledgerId": {
          "type": "string",
          "description": "Associated revenue ledger identifier"
        },
        "realTimeUpdates": {
          "type": "boolean",
          "default": true,
          "description": "Whether to push updates to ledger in real-time"
        },
        "transactionTracking": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "lastTransactionId": { "type": "string" },
            "totalRevenue": { "type": "number" },
            "currency": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": ["active", "inactive", "testing", "suspended"],
      "description": "Current status of the pricing configuration"
    },
    "effectiveFrom": {
      "type": "string",
      "format": "date-time",
      "description": "When this pricing configuration becomes effective"
    },
    "effectiveUntil": {
      "type": "string",
      "format": "date-time",
      "description": "When this pricing configuration expires (optional)"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "pricingId",
    "franchiseId",
    "region",
    "currency",
    "viewerTier",
    "priceModel",
    "status"
  ],
  "additionalProperties": false
}
